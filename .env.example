# Copy to .env and fill in. `.env` is gitignored — never commit real secrets.
# Generate values with: openssl rand -hex 16  (password) / openssl rand -hex 32  (jwt)
# The password in DATABASE_URL must match POSTGRES_PASSWORD.
POSTGRES_PASSWORD=changeme
JWT_SECRET=changeme
DATABASE_URL=postgres://multica:changeme@multica-postgres:5432/multica?sslmode=disable
# Personal access token minted once from the web UI (Settings -> Tokens) after first login.
# Leave blank on first boot; the daemon service retries until it is set.
MULTICA_TOKEN=
